# ─── AI Provider API Keys ─────────────────────────────────────────────────────
# At least one key must be set. Active providers are auto-detected.

OPENAI_API_KEY=           # platform.openai.com → API Keys
ANTHROPIC_API_KEY=        # console.anthropic.com → API Keys
PERPLEXITY_API_KEY=       # perplexity.ai/settings/api
GOOGLE_AI_API_KEY=        # aistudio.google.com → Get API Key

# ─── LLM Backend (setup2.py) ──────────────────────────────────────────────────
# Controls which model powers the AISO pipeline.
# "local" = Ollama (free, private, offline)  |  "api" = OpenAI (paid)
# Can also be overridden at runtime with:  python3 setup2.py <slug> --llm api
LLM_BACKEND=local                        # default: local (Ollama)
OLLAMA_MODEL=llama3                      # model to use  (ollama pull llama3)
OLLAMA_HOST=http://localhost:11434       # Ollama server URL

# ─── Optional tuning ──────────────────────────────────────────────────────────
# COLLECT_QUESTION_TIMEOUT_SEC=120   # Per-question timeout (default: 120s)
