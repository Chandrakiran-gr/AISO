{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r api/requirements.txt -r requirements.txt"
  },
  "deploy": {
    "startCommand": "PYTHONPATH=/app procrastinate --app api.worker.app worker --concurrency 1",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
