# ─── Secrets & Keys (CRITICAL — never commit these) ──────────────────────────
.env
*.env
!*.env.example
*-key*.json
*credentials*.json
**/service*account*.json
**/integratedai-aio-*.json

# ─── Client Data (sensitive — stays local only) ──────────────────────────────
clients/
storage/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# ─── Webish session & results ────────────────────────────────────────────────
webish/.session/
webish/results/

# ─── IDE & Editor ────────────────────────────────────────────────────────────
.cursor/
.claude/
.gemini/
.DS_Store
Thumbs.db
*.code-workspace
.vscode/
.idea/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Node / Next.js ──────────────────────────────────────────────────────────
node_modules/
.firebase/
.firebaserc
web/.next/
web/out/
web/.env.local
web/.env*.local

# ─── Database (local dev SQLite) ─────────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ─── FastAPI / Python ─────────────────────────────────────────────────────────
api/__pycache__/
api/routes/__pycache__/

# ─── OS ──────────────────────────────────────────────────────────────────────
*.swp
*.swo
*~
