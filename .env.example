# ── AISO Environment Variables ─────────────────────────────────
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only backend URL for Next.js auth calls. Optional locally.
AISO_API_URL=http://localhost:8000

# ── NextAuth ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-nextauth-secret-here
# Shared server-to-server secret for OAuth user persistence.
# In local dev this may match AUTH_SECRET; production should set a strong value.
AISO_INTERNAL_API_SECRET=your-internal-api-secret-here

# Google OAuth (free) — https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ── FastAPI ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./aiso.db
ENV=development
# Production should set this to 0 and run Alembic migrations instead.
AISO_AUTO_CREATE_TABLES=1

# Temporary local entitlement override for raw artifact exports.
# Backend enforces downloads; frontend uses the NEXT_PUBLIC value only for UI.
AISO_ARTIFACT_ACCESS_EMAILS=admin@aisoglobal.com
NEXT_PUBLIC_AISO_ARTIFACT_ACCESS_EMAILS=admin@aisoglobal.com

# ── Website Context Discovery ─────────────────────────────────
# Static public HTML ingestion is always available. Enable rendered DOM extraction
# only where Playwright/Chromium is installed and monitored.
AISO_INGEST_RENDERED=0

# ── AI Provider Keys (for pipeline execution) ──────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
GOOGLE_AI_API_KEY=AIza...

# Optional provider performance controls.
# Paid Gemini/API-credit projects should usually keep no fixed delay.
# If a key is on Gemini free tier, set AISO_GEMINI_MIN_INTERVAL_SEC=12.
AISO_OPENAI_CONCURRENCY=5
AISO_CLAUDE_CONCURRENCY=5
AISO_PERPLEXITY_CONCURRENCY=3
AISO_GEMINI_CONCURRENCY=2
AISO_GEMINI_MIN_INTERVAL_SEC=0

# ── Question Generation & Ranking ─────────────────────────────
# Candidate generation/ranking is deterministic and local by default.
# The final bank is what collect.py runs unless AISO_PICK_ALL is explicitly set.
AISO_QUESTION_CANDIDATE_LIMIT_PER_GROUP=150
AISO_QUESTION_GROUP_TARGETS=G1:14,G2:18,G3:22,G4:24,G5:20,G6:12,G7:16
# Optional emergency/admin cap: top N questions per selected group at collection time.
# Leave unset to run the curated final bank.
# AISO_PICK_ALL=14

# ── Production only (swap in when ready) ──────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/aiso
# REDIS_URL=redis://default:password@host:6379
