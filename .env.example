# ── AISO Environment Variables ─────────────────────────────────
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only backend URL for Next.js auth calls. Optional locally.
AISO_API_URL=http://localhost:8000

# ── NextAuth ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-nextauth-secret-here
# Shared server-to-server secret for OAuth user persistence.
# In local dev this may match AUTH_SECRET; production should set a strong value.
AISO_INTERNAL_API_SECRET=your-internal-api-secret-here

# Google OAuth (free) — https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ── FastAPI ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./aiso.db
ENV=development
# Production should set this to 0 and run Alembic migrations instead.
AISO_AUTO_CREATE_TABLES=1
# Comma-separated frontend origins allowed to call FastAPI.
AISO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview URLs. For private beta, prefer exact origins above
# once Vercel gives you the final staging URL.
# AISO_ALLOWED_ORIGIN_REGEX=https://.*\\.vercel\\.app
# Comma-separated hosts accepted by FastAPI TrustedHostMiddleware.
AISO_ALLOWED_HOSTS=localhost,127.0.0.1,*.up.railway.app

# Private beta entitlement defaults. Admin emails are promoted to custom/admin.
AISO_ADMIN_EMAILS=admin@aisoglobal.com
AISO_DEFAULT_PLAN_TIER=pro

# ── Artifact Storage ──────────────────────────────────────────
# local keeps generated scan artifacts on disk.
# onedrive uploads durable artifacts to the founder-managed OneDrive.
AISO_STORAGE_BACKEND=onedrive
AISO_STORAGE_ROOT=storage
AISO_ONEDRIVE_BASE_PATH=/AISO
MICROSOFT_TENANT=consumers
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=

# ── Website Context Discovery ─────────────────────────────────
# Static public HTML ingestion is always available. Enable rendered DOM extraction
# only where Playwright/Chromium is installed and monitored.
AISO_INGEST_RENDERED=0

# ── Source Intelligence Enrichment ────────────────────────────
# Runs after a scan is already marked complete. It fetches only the top cited
# public source pages, stores compact metadata, and never stores full HTML.
AISO_SOURCE_ENRICHMENT_ENABLED=1
AISO_SOURCE_ENRICHMENT_MAX_SOURCES=20
AISO_SOURCE_ENRICHMENT_TIMEOUT_SEC=5
AISO_SOURCE_ENRICHMENT_MAX_BYTES=1000000
AISO_SOURCE_ENRICHMENT_CONCURRENCY=3

# ── AI Provider Keys (for pipeline execution) ──────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
GOOGLE_AI_API_KEY=AIza...

# Optional provider performance controls.
# Paid Gemini/API-credit projects should usually keep no fixed delay.
# If a key is on Gemini free tier, set AISO_GEMINI_MIN_INTERVAL_SEC=12.
AISO_OPENAI_CONCURRENCY=5
AISO_CLAUDE_CONCURRENCY=5
AISO_PERPLEXITY_CONCURRENCY=3
AISO_GEMINI_CONCURRENCY=2
AISO_GEMINI_MIN_INTERVAL_SEC=0

# ── Assistant ─────────────────────────────────────────────────
# Uses the server-side ANTHROPIC_API_KEY above. Do not expose this in frontend env.
AISO_ASSISTANT_LLM_PROVIDER=anthropic
AISO_ASSISTANT_LLM_MODEL=claude-sonnet-4-6
AISO_ASSISTANT_RATE_LIMIT_RPH=60
AISO_CONVERSATION_RETENTION_DAYS=90

# ── Question Generation & Ranking ─────────────────────────────
# Candidate generation/ranking is deterministic and local by default.
# The final bank is what collect.py runs unless AISO_PICK_ALL is explicitly set.
AISO_QUESTION_CANDIDATE_LIMIT_PER_GROUP=150
AISO_QUESTION_GROUP_TARGETS=G1:8,G2:8,G3:8,G4:8,G5:8,G6:10,G7:10
# Optional analyst-only extended bank written beside query_template_bank.csv.
# collect.py ignores it unless you intentionally swap/copy it for deeper testing.
# AISO_QUESTION_WRITE_EXTENDED_BANK=1
# AISO_QUESTION_EXTENDED_GROUP_TARGETS=G1:16,G2:12,G3:16,G4:14,G5:12,G6:20,G7:20
# Optional emergency/admin cap: top N questions per selected group at collection time.
# Leave unset to run the curated final bank.
# AISO_PICK_ALL=14

# ── Production only (swap in when ready) ──────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/aiso
# REDIS_URL=redis://default:password@host:6379

# ── Staging/private beta example ──────────────────────────────
# Frontend on Vercel, backend/Postgres on Railway.
# NODE_ENV=production
# ENV=staging
# NEXT_PUBLIC_APP_URL=https://aiso-staging.vercel.app
# AUTH_URL=https://aiso-staging.vercel.app/api/auth
# NEXT_PUBLIC_API_URL=https://aiso-api-staging.up.railway.app
# AISO_API_URL=https://aiso-api-staging.up.railway.app
# DATABASE_URL=postgresql://postgres:password@host.railway.internal:5432/railway
# AISO_AUTO_CREATE_TABLES=0
# AISO_ALLOWED_ORIGINS=https://aiso-staging.vercel.app
# AISO_ALLOWED_HOSTS=aiso-api-staging.up.railway.app,*.up.railway.app

# ── Render deployment example ─────────────────────────────────
# Frontend on Vercel, backend + PostgreSQL on Render.
# NODE_ENV=production
# ENV=production
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# AUTH_URL=https://your-app.vercel.app/api/auth
# NEXT_PUBLIC_API_URL=https://aiso-api.onrender.com
# AISO_API_URL=https://aiso-api.onrender.com
# DATABASE_URL=postgresql://aiso:password@host/aiso   (auto-set by render.yaml)
# AISO_AUTO_CREATE_TABLES=0
# AISO_ALLOWED_ORIGINS=https://your-app.vercel.app
# AISO_ALLOWED_HOSTS=aiso-api.onrender.com,*.onrender.com
