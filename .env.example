# ─── AISO Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git!

# ─── AI Provider API Keys ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_AI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── LLM Backend (for setup2.py ranking pipeline) ────────────────────────────
# Options: "api" (OpenAI cloud) or "local" (Ollama)
LLM_BACKEND=api

# ─── Local Ollama (only needed if LLM_BACKEND=local) ─────────────────────────
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434

# ─── Collection Settings ─────────────────────────────────────────────────────
# Timeout per question in seconds (default: 120)
COLLECT_QUESTION_TIMEOUT_SEC=120
